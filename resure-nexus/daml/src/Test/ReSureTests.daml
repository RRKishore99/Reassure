      confirmTime = now
      confirmer = tp.operations

  return ()

-- | Test: Partial settlement only when permitted
testPartialSettlementRestriction : Script ()
testPartialSettlementRestriction = do
  tp <- setupParties
  let now = time (date 2024 May 1) 10 0 0

  -- Settlement that does NOT permit partial
  settlementCid <- submitMulti [tp.cedant, tp.reinsurer1] [] do
    createCmd RecoverableSettlement with
      cedant = tp.cedant
      reinsurer = tp.reinsurer1
      broker = tp.broker
      operations = tp.operations
      audit = tp.audit
      settlementRef = "SETT-2024-003"
      allocationRef = "ALLOC-003"
      cycleRef = "CYCLE-002"
      claimRef = "CLM-2024-003"
      treatyRef = "QS-2024-001"
      amountDue = usd 100000.0
      amountPaid = usd 0.0
      amountOutstanding = usd 100000.0
      currency = USD
      dueDate = None
      settlementStatus = SettlementPending
      isPartialSettlementPermitted = False
      paymentEvidence = []
      reconciliationRefs = []
      createdAt = now
      lastUpdatedAt = now

  instructedCid <- submit tp.operations do
    exerciseCmd settlementCid InstructSettlement with instructTime = now

  -- Partial payment should fail when not permitted
  submitMustFail tp.operations do
    exerciseCmd instructedCid ConfirmPayment with
      confirmedAmount = usd 50000.0
      evidence = testEvidence tp.operations now
      confirmTime = now
      confirmer = tp.operations

  return ()

-- =============================================================================
-- INTEGRATION: FULL WORKFLOW TEST
-- =============================================================================

-- | End-to-end test: Treaty → Claim → Assessment → Allocation → Settlement
testFullWorkflow : Script ()
testFullWorkflow = do
  tp <- setupParties
  let now = time (date 2024 Jan 15) 10 0 0

  -- 1. Create and approve quota-share treaty
  treatyCid <- submit tp.cedant do
    createCmd TreatyVersion with
      cedant = tp.cedant
      broker = tp.broker
      operations = tp.operations
      audit = tp.audit
      treatyRef = "QS-FULL-001"
      version = 1
      treatyType = QuotaShare
      effectivePeriod = DateRange (date 2024 Jan 1) (date 2024 Dec 31)
      coveredBusiness = "Property"
      lossBasis = GrossLoss
      currency = USD
      cededPercentage = Some 70.0
      contractualCap = Some 5000000.0
      attachmentPoint = None
      layerLimit = None
      deductibleRules = "Standard"
      eligibleLossMethod = "Gross loss"
      approvalState = ApprovalPending
      evidenceRefs = []
      createdAt = now
      previousVersion = None

  approvedTreatyCid <- submit tp.cedant do
    exerciseCmd treatyCid ApproveTreaty with
      approver = tp.cedant
      approvalTime = now

  -- 2. Reinsurer participation
  proposalCid <- submit tp.cedant do
    createCmd TreatyParticipationProposal with
      cedant = tp.cedant
      reinsurer = tp.reinsurer1
      broker = tp.broker
      operations = tp.operations
      audit = tp.audit
      treatyVersionCid = approvedTreatyCid
      treatyRef = "QS-FULL-001"
      treatyVersion = 1
      proposedLinePercentage = 60.0
      coveredLayer = "100% ceded"
      currency = USD
      evidenceRefs = []
      proposedAt = now

  participationCid <- submit tp.reinsurer1 do
    exerciseCmd proposalCid AcceptProposal with
      acceptTime = now
      acceptEvidence = None

  -- 3. Register and submit claim
  submit tp.operations do
    createCmd ClaimRegistry with
      registrar = tp.operations
      cedant = tp.cedant
      audit = tp.audit
      claimRef = "CLM-FULL-001"
      policyRef = "POL-FULL-100"
      registeredAt = now
      isActive = True

  claimCid <- submit tp.cedant do
    createCmd ClaimCase with
      cedant = tp.cedant
      broker = tp.broker
      adjuster = tp.adjuster
      operations = tp.operations
      audit = tp.audit
      claimRef = "CLM-FULL-001"
      policyRef = "POL-FULL-100"
      dateOfLoss = date 2024 Feb 15
      occurrenceRef = None
      grossAmount = usd 1000000.0
      netAmount = None
      applicableTreatyRefs = ["QS-FULL-001"]
      claimStatus = ClaimSubmitted
      evidenceRefs = [testEvidence tp.cedant now]
      submittedAt = now
      submittedBy = tp.cedant
      lastUpdatedAt = now
      notes = "Major fire incident"

  assessingCid <- submit tp.cedant do
    exerciseCmd claimCid SubmitForAssessment with submissionTime = now

  -- 4. Loss assessment
  assessmentCid <- submit tp.adjuster do
    createCmd LossAssessment with
      adjuster = tp.adjuster
      cedant = tp.cedant
      broker = tp.broker
      operations = tp.operations
      audit = tp.audit
      claimRef = "CLM-FULL-001"
      assessmentRef = "ASS-FULL-001"
      assessmentVersion = 1
      assessedAmount = usd 1000000.0
      deductibleAmount = None
      salvageAmount = None
      subrogationAmount = None
      otherRecoveries = None
      eligibleLoss = usd 1000000.0
      methodology = "Full site inspection"
      lossBasisApplied = GrossLoss
      evidenceRefs = [testEvidence tp.adjuster now]
      assessmentStatus = AssessmentDraft
      submittedAt = now
      approvedAt = None
      approvedBy = None
      previousVersion = None
      notes = ""

  submittedAssessCid <- submit tp.adjuster do
    exerciseCmd assessmentCid SubmitAssessment with submitTime = now

  approvedAssessCid <- submit tp.operations do
    exerciseCmd submittedAssessCid ApproveAssessment with
      approver = tp.operations
      approvalTime = now

  -- 5. Mark claim as assessed
  assessedClaimCid <- submit tp.operations do
    exerciseCmd assessingCid MarkClaimAssessed with assessmentTime = now

  -- 6. Allocation cycle
  -- Quota-share: 70% ceded, Reinsurer1 has 60% line
  -- Eligible loss = 1,000,000
  -- Ceded amount = 1,000,000 × 70% = 700,000
  -- Capped: min(700,000, 5,000,000) = 700,000
  -- Reinsurer1 allocation = 700,000 × 60% = 420,000
  let calcEvidence = CalculationEvidence with
        formula = "QS: eligibleLoss × cededPct × reinsurerLine"
        inputs =
          [ ("eligibleLoss", "1000000.00")
          , ("cededPercentage", "70.00")
          , ("contractualCap", "5000000.00")
          , ("reinsurerLine", "60.00")
          ]
        intermediates =
          [ ("cededAmount", "700000.00")
          , ("cappedCededAmount", "700000.00")
          ]
        roundingRule = RoundHalfEven
        result = 420000.0
        calculatedAt = now
        calculatedBy = tp.operations

  cycleCid <- submit tp.operations do
    createCmd AllocationCycle with
      operations = tp.operations
      cedant = tp.cedant
      broker = tp.broker
      audit = tp.audit
      cycleRef = "CYCLE-FULL-001"
      claimRefs = ["CLM-FULL-001"]
      occurrenceRef = None
      assessmentRef = "ASS-FULL-001"
      assessmentVersion = 1
      treatyRef = "QS-FULL-001"
      treatyVersion = 1
      treatyType = QuotaShare
      eligibleLoss = usd 1000000.0
      calculatedRecoverable = usd 420000.0
      calculationEvidence = calcEvidence
      currency = USD
      allocationStatus = AllocationProposed
      createdAt = now
      finalizedAt = None
      evidenceRefs = []

  -- Register allocation (duplicate prevention)
  submit tp.operations do
    createCmd AllocationRegistry with
      registrar = tp.operations
      cedant = tp.cedant
      reinsurer = tp.reinsurer1
      audit = tp.audit
      claimRef = "CLM-FULL-001"
      treatyRef = "QS-FULL-001"
      treatyVersion = 1
      allocationRef = "ALLOC-FULL-001"
      registeredAt = now
      isActive = True

  -- Propose allocation to reinsurer
  proposalAllocCid <- submit tp.cedant do
    createCmd AllocationProposal with
      cedant = tp.cedant
      reinsurer = tp.reinsurer1
      broker = tp.broker
      operations = tp.operations
      audit = tp.audit
      allocationRef = "ALLOC-FULL-001"
      cycleRef = "CYCLE-FULL-001"
      treatyRef = "QS-FULL-001"
      treatyVersion = 1
      claimRef = "CLM-FULL-001"
      occurrenceRef = None
      allocatedAmount = usd 420000.0
      linePercentage = 60.0
      calculationEvidence = calcEvidence
      evidenceRefs = []
      proposedAt = now

  -- Reinsurer accepts
  allocationCid <- submit tp.reinsurer1 do
    exerciseCmd proposalAllocCid AcceptAllocationProposal with
      acceptTime = now
      acceptEvidence = None

  -- Finalize allocation
  finalizedAllocCid <- submit tp.operations do
    exerciseCmd allocationCid FinalizeAllocation with finalizeTime = now

  -- 7. Settlement
  settlementCid <- submitMulti [tp.cedant, tp.reinsurer1] [] do
    createCmd RecoverableSettlement with
      cedant = tp.cedant
      reinsurer = tp.reinsurer1
      broker = tp.broker
      operations = tp.operations
      audit = tp.audit
      settlementRef = "SETT-FULL-001"
      allocationRef = "ALLOC-FULL-001"
      cycleRef = "CYCLE-FULL-001"
      claimRef = "CLM-FULL-001"
      treatyRef = "QS-FULL-001"
      amountDue = usd 420000.0
      amountPaid = usd 0.0
      amountOutstanding = usd 420000.0
      currency = USD
      dueDate = Some (date 2024 Jun 1)
      settlementStatus = SettlementPending
      isPartialSettlementPermitted = False
      paymentEvidence = []
      reconciliationRefs = []
      createdAt = now
      lastUpdatedAt = now

  instructedCid <- submit tp.operations do
    exerciseCmd settlementCid InstructSettlement with instructTime = now

  confirmedCid <- submit tp.operations do
    exerciseCmd instructedCid ConfirmPayment with
      confirmedAmount = usd 420000.0
      evidence = testEvidence tp.operations now
      confirmTime = now
      confirmer = tp.operations

  return ()
