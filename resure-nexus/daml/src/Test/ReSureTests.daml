      coveredBusiness = "Marine"
      lossBasis = GrossLoss
      currency = USD
      cededPercentage = Some 50.0
      contractualCap = None
      attachmentPoint = None
      layerLimit = None
      deductibleRules = "None"
      eligibleLossMethod = "Gross loss"
      approvalState = ApprovalPending
      evidenceRefs = []
      createdAt = now
      previousVersion = None

  approvedCid <- submit tp.cedant do
    exerciseCmd treatyCid ApproveTreaty with
      approver = tp.cedant
      approvalTime = now

  proposalCid <- submit tp.cedant do
    createCmd TreatyParticipationProposal with
      cedant = tp.cedant
      reinsurer = tp.reinsurer1
      broker = tp.broker
      operations = tp.operations
      audit = tp.audit
      treatyVersionCid = approvedCid
      treatyRef = "QS-2024-005"
      treatyVersion = 1
      proposedLinePercentage = 50.0
      coveredLayer = "Full"
      currency = USD
      evidenceRefs = []
      proposedAt = now

  -- Broker tries to accept — must fail
  submitMustFail tp.broker do
    exerciseCmd proposalCid AcceptProposal with
      acceptTime = now
      acceptEvidence = None

  return ()

-- =============================================================================
-- CLAIM TESTS
-- =============================================================================

-- | Test: Full claim lifecycle
testClaimLifecycle : Script ()
testClaimLifecycle = do
  tp <- setupParties
  let now = time (date 2024 Mar 1) 10 0 0

  -- Submit claim
  claimCid <- submit tp.cedant do
    createCmd ClaimCase with
      cedant = tp.cedant
      broker = tp.broker
      adjuster = tp.adjuster
      operations = tp.operations
      audit = tp.audit
      claimRef = "CLM-2024-001"
      policyRef = "POL-2024-100"
      dateOfLoss = date 2024 Feb 15
      occurrenceRef = None
      grossAmount = usd 500000.0
      netAmount = None
      applicableTreatyRefs = ["QS-2024-003"]
      claimStatus = ClaimSubmitted
      evidenceRefs = [testEvidence tp.cedant now]
      submittedAt = now
      submittedBy = tp.cedant
      lastUpdatedAt = now
      notes = "Fire damage to warehouse"

  -- Submit for assessment
  assessingCid <- submit tp.cedant do
    exerciseCmd claimCid SubmitForAssessment with
      submissionTime = now

  -- Mark assessed
  assessedCid <- submit tp.operations do
    exerciseCmd assessingCid MarkClaimAssessed with
      assessmentTime = now

  -- Mark allocated
  allocatedCid <- submit tp.operations do
    exerciseCmd assessedCid MarkClaimAllocated with
      allocationTime = now

  -- Mark fully settled
  settledCid <- submit tp.operations do
    exerciseCmd allocatedCid MarkClaimFullySettled with
      settlementTime = now

  -- Close claim
  closedCid <- submit tp.cedant do
    exerciseCmd settledCid CloseClaim with
      closeTime = now

  return ()

-- | Test: Cannot skip claim states
testCannotSkipClaimStates : Script ()
testCannotSkipClaimStates = do
  tp <- setupParties
  let now = time (date 2024 Mar 1) 10 0 0

  claimCid <- submit tp.cedant do
    createCmd ClaimCase with
      cedant = tp.cedant
      broker = tp.broker
      adjuster = tp.adjuster
      operations = tp.operations
      audit = tp.audit
      claimRef = "CLM-2024-002"
      policyRef = "POL-2024-101"
      dateOfLoss = date 2024 Feb 20
      occurrenceRef = None
      grossAmount = usd 100000.0
      netAmount = None
      applicableTreatyRefs = []
      claimStatus = ClaimSubmitted
      evidenceRefs = []
      submittedAt = now
      submittedBy = tp.cedant
      lastUpdatedAt = now
      notes = ""

  -- Cannot directly mark as assessed (must go through SubmitForAssessment first)
  submitMustFail tp.operations do
    exerciseCmd claimCid MarkClaimAssessed with
      assessmentTime = now

  -- Cannot close a submitted claim
  submitMustFail tp.cedant do
    exerciseCmd claimCid CloseClaim with
      closeTime = now

  return ()

-- | Test: Reopen closed claim
testReopenClosedClaim : Script ()
testReopenClosedClaim = do
  tp <- setupParties
  let now = time (date 2024 Mar 1) 10 0 0

  -- Create and fully lifecycle a claim
  claimCid <- submit tp.cedant do
    createCmd ClaimCase with
      cedant = tp.cedant
      broker = tp.broker
      adjuster = tp.adjuster
      operations = tp.operations
      audit = tp.audit
      claimRef = "CLM-2024-003"
      policyRef = "POL-2024-102"
      dateOfLoss = date 2024 Feb 25
      occurrenceRef = None
      grossAmount = usd 200000.0
      netAmount = None
      applicableTreatyRefs = []
      claimStatus = ClaimSubmitted
      evidenceRefs = []
      submittedAt = now
      submittedBy = tp.cedant
      lastUpdatedAt = now
      notes = ""

  assessingCid <- submit tp.cedant do
    exerciseCmd claimCid SubmitForAssessment with submissionTime = now
  assessedCid <- submit tp.operations do
    exerciseCmd assessingCid MarkClaimAssessed with assessmentTime = now
  allocatedCid <- submit tp.operations do
    exerciseCmd assessedCid MarkClaimAllocated with allocationTime = now
  settledCid <- submit tp.operations do
    exerciseCmd allocatedCid MarkClaimFullySettled with settlementTime = now
  closedCid <- submit tp.cedant do
    exerciseCmd settledCid CloseClaim with closeTime = now

  -- Reopen
  reopenedCid <- submit tp.cedant do
    exerciseCmd closedCid ReopenClaim with
      reopenTime = now
      reason = "New evidence discovered"

  return ()

