-- =============================================================================
-- OCCURRENCE TESTS
-- =============================================================================

-- | Test: Loss occurrence with frozen membership
testLossOccurrenceFreeze : Script ()
testLossOccurrenceFreeze = do
  tp <- setupParties
  let now = time (date 2024 Mar 10) 10 0 0

  occCid <- submit tp.cedant do
    createCmd LossOccurrence with
      cedant = tp.cedant
      broker = tp.broker
      adjuster = tp.adjuster
      operations = tp.operations
      audit = tp.audit
      occurrenceRef = "OCC-2024-001"
      dateOfOccurrence = date 2024 Feb 15
      description = "Hurricane damage event"
      memberClaimRefs = []
      isFrozen = False
      frozenAt = None
      totalEligibleLoss = None
      currency = USD
      evidenceRefs = []
      createdAt = now

  -- Add claims
  occ1 <- submit tp.cedant do
    exerciseCmd occCid AddClaimToOccurrence with
      claimRef = "CLM-2024-010"
      addTime = now

  occ2 <- submit tp.cedant do
    exerciseCmd occ1 AddClaimToOccurrence with
      claimRef = "CLM-2024-011"
      addTime = now

  occ3 <- submit tp.cedant do
    exerciseCmd occ2 AddClaimToOccurrence with
      claimRef = "CLM-2024-012"
      addTime = now

  -- Freeze membership
  frozenCid <- submit tp.operations do
    exerciseCmd occ3 FreezeOccurrence with
      aggregatedLoss = usd 3500000.0
      freezeTime = now

  -- Cannot add more claims after freeze (normal path)
  submitMustFail tp.cedant do
    exerciseCmd frozenCid AddClaimToOccurrence with
      claimRef = "CLM-2024-013"
      addTime = now

  return ()

-- | Test: Late claim addition after freeze (controlled correction)
testLateClaim : Script ()
testLateClaim = do
  tp <- setupParties
  let now = time (date 2024 Mar 10) 10 0 0

  occCid <- submit tp.cedant do
    createCmd LossOccurrence with
      cedant = tp.cedant
      broker = tp.broker
      adjuster = tp.adjuster
      operations = tp.operations
      audit = tp.audit
      occurrenceRef = "OCC-2024-002"
      dateOfOccurrence = date 2024 Feb 20
      description = "Flood event"
      memberClaimRefs = ["CLM-2024-020"]
      isFrozen = False
      frozenAt = None
      totalEligibleLoss = None
      currency = USD
      evidenceRefs = []
      createdAt = now

  frozenCid <- submit tp.operations do
    exerciseCmd occCid FreezeOccurrence with
      aggregatedLoss = usd 1500000.0
      freezeTime = now

  -- Operations adds late claim with revised total
  lateCid <- submit tp.operations do
    exerciseCmd frozenCid AddLateClaim with
      claimRef = "CLM-2024-021"
      correctionReason = "Late reported damage to adjacent property"
      newAggregatedLoss = usd 2000000.0
      correctionTime = now

  return ()

-- | Test: Cannot add duplicate claim to occurrence
testCannotAddDuplicateClaimToOccurrence : Script ()
testCannotAddDuplicateClaimToOccurrence = do
  tp <- setupParties
  let now = time (date 2024 Mar 10) 10 0 0

  occCid <- submit tp.cedant do
    createCmd LossOccurrence with
      cedant = tp.cedant
      broker = tp.broker
      adjuster = tp.adjuster
      operations = tp.operations
      audit = tp.audit
      occurrenceRef = "OCC-2024-003"
      dateOfOccurrence = date 2024 Feb 25
      description = "Earthquake"
      memberClaimRefs = []
      isFrozen = False
      frozenAt = None
      totalEligibleLoss = None
      currency = USD
      evidenceRefs = []
      createdAt = now

  occ1 <- submit tp.cedant do
    exerciseCmd occCid AddClaimToOccurrence with
      claimRef = "CLM-2024-030"
      addTime = now

  -- Duplicate should fail
  submitMustFail tp.cedant do
    exerciseCmd occ1 AddClaimToOccurrence with
      claimRef = "CLM-2024-030"
      addTime = now

  return ()

-- =============================================================================
-- REGISTRY / DUPLICATE PREVENTION TESTS
-- =============================================================================

-- | Test: Cannot create duplicate claim registry entry
testDuplicateClaimRegistryPrevention : Script ()
testDuplicateClaimRegistryPrevention = do
  tp <- setupParties
  let now = time (date 2024 Mar 1) 10 0 0

  -- Register first claim
  submit tp.operations do
    createCmd ClaimRegistry with
      registrar = tp.operations
      cedant = tp.cedant
      audit = tp.audit
      claimRef = "CLM-2024-UNIQUE-001"
      policyRef = "POL-001"
      registeredAt = now
      isActive = True

  -- Duplicate should fail (same key)
  submitMustFail tp.operations do
    createCmd ClaimRegistry with
      registrar = tp.operations
      cedant = tp.cedant
      audit = tp.audit
      claimRef = "CLM-2024-UNIQUE-001"
      policyRef = "POL-002"
      registeredAt = now
      isActive = True

  return ()

-- | Test: Cannot create duplicate allocation registry entry
testDuplicateAllocationRegistryPrevention : Script ()
testDuplicateAllocationRegistryPrevention = do
  tp <- setupParties
  let now = time (date 2024 Mar 1) 10 0 0

  submit tp.operations do
    createCmd AllocationRegistry with
      registrar = tp.operations
      cedant = tp.cedant
      reinsurer = tp.reinsurer1
      audit = tp.audit
      claimRef = "CLM-2024-001"
      treatyRef = "QS-2024-001"
      treatyVersion = 1
      allocationRef = "ALLOC-001"
      registeredAt = now
      isActive = True

  -- Same claim + treaty + reinsurer combo should fail
  submitMustFail tp.operations do
    createCmd AllocationRegistry with
      registrar = tp.operations
      cedant = tp.cedant
      reinsurer = tp.reinsurer1
      audit = tp.audit
      claimRef = "CLM-2024-001"
      treatyRef = "QS-2024-001"
      treatyVersion = 1
      allocationRef = "ALLOC-002"
      registeredAt = now
      isActive = True

  -- Different reinsurer should succeed (different key)
  submit tp.operations do
    createCmd AllocationRegistry with
      registrar = tp.operations
      cedant = tp.cedant
      reinsurer = tp.reinsurer2
      audit = tp.audit
      claimRef = "CLM-2024-001"
      treatyRef = "QS-2024-001"
      treatyVersion = 1
      allocationRef = "ALLOC-003"
      registeredAt = now
      isActive = True

  return ()

-- =============================================================================
-- DISPUTE TESTS
-- =============================================================================

-- | Test: Dispute lifecycle
testDisputeLifecycle : Script ()
testDisputeLifecycle = do
  tp <- setupParties
  let now = time (date 2024 Apr 1) 10 0 0

  -- Create dispute (requires both cedant and reinsurer as signatories)
  disputeCid <- submitMulti [tp.cedant, tp.reinsurer1] [] do
    createCmd DisputeCase with
      cedant = tp.cedant
      reinsurer = tp.reinsurer1
      broker = tp.broker
      operations = tp.operations
      audit = tp.audit
      disputeRef = "DISP-2024-001"
      allocationRef = "ALLOC-001"
      cycleRef = "CYCLE-001"
      claimRef = "CLM-2024-001"
      treatyRef = "QS-2024-001"
      disputedAmount = Some (usd 50000.0)
      originalAmount = usd 200000.0
      reason = "Assessment methodology disputed"
      supportingEvidence = []
      disputeStatus = DisputeRaised
      resolution = None
      resolvedAmount = None
      resolvedAt = None
      resolvedBy = None
      raisedAt = now
      raisedBy = tp.reinsurer1

  -- Move to review
  reviewCid <- submit tp.operations do
    exerciseCmd disputeCid SubmitDisputeForReview with
      reviewTime = now

  -- Resolve
  resolvedCid <- submit tp.operations do
    exerciseCmd reviewCid ResolveDispute with
      resolutionText = "Revised calculation agreed by both parties"
      finalAmount = usd 180000.0
      resolveTime = now
      resolver = tp.operations
      resolutionEvidence = []

  return ()

-- =============================================================================
-- SETTLEMENT TESTS
-- =============================================================================

-- | Test: Settlement lifecycle — cannot say "Paid" until confirmed
testSettlementLifecycle : Script ()
testSettlementLifecycle = do
  tp <- setupParties
  let now = time (date 2024 May 1) 10 0 0

  settlementCid <- submitMulti [tp.cedant, tp.reinsurer1] [] do
    createCmd RecoverableSettlement with
      cedant = tp.cedant
      reinsurer = tp.reinsurer1
      broker = tp.broker
      operations = tp.operations
      audit = tp.audit
      settlementRef = "SETT-2024-001"
      allocationRef = "ALLOC-001"
      cycleRef = "CYCLE-001"
      claimRef = "CLM-2024-001"
      treatyRef = "QS-2024-001"
      amountDue = usd 200000.0
      amountPaid = usd 0.0
      amountOutstanding = usd 200000.0
      currency = USD
      dueDate = Some (date 2024 Jun 1)
      settlementStatus = SettlementPending
      isPartialSettlementPermitted = False
      paymentEvidence = []
      reconciliationRefs = []
      createdAt = now
      lastUpdatedAt = now

  -- Cannot confirm before instruction
  submitMustFail tp.operations do
    exerciseCmd settlementCid ConfirmPayment with
      confirmedAmount = usd 200000.0
      evidence = testEvidence tp.operations now
      confirmTime = now
      confirmer = tp.operations

  -- Instruct payment
  instructedCid <- submit tp.operations do
    exerciseCmd settlementCid InstructSettlement with
      instructTime = now

  -- Confirm full payment
  confirmedCid <- submit tp.operations do
    exerciseCmd instructedCid ConfirmPayment with
      confirmedAmount = usd 200000.0
      evidence = testEvidence tp.operations now
      confirmTime = now
      confirmer = tp.operations

  return ()

-- | Test: Cannot overpay settlement
testCannotOverpaySettlement : Script ()
testCannotOverpaySettlement = do
  tp <- setupParties
  let now = time (date 2024 May 1) 10 0 0

  settlementCid <- submitMulti [tp.cedant, tp.reinsurer1] [] do
    createCmd RecoverableSettlement with
      cedant = tp.cedant
