      allocationRef = "ALLOC-002"
      cycleRef = "CYCLE-001"
      claimRef = "CLM-2024-002"
      treatyRef = "QS-2024-001"
      amountDue = usd 100000.0
      amountPaid = usd 0.0
      amountOutstanding = usd 100000.0
      currency = USD
      dueDate = None
      settlementStatus = SettlementPending
