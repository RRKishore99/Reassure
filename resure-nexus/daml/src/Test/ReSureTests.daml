-- | Test: Cannot approve already-approved treaty
testCannotDoubleApproveTreaty : Script ()
testCannotDoubleApproveTreaty = do
  tp <- setupParties
  let now = time (date 2024 Jan 15) 10 0 0

  treatyCid <- submit tp.cedant do
    createCmd TreatyVersion with
      cedant = tp.cedant
      broker = tp.broker
      operations = tp.operations
      audit = tp.audit
      treatyRef = "QS-2024-002"
      version = 1
      treatyType = QuotaShare
      effectivePeriod = DateRange (date 2024 Jan 1) (date 2024 Dec 31)
      coveredBusiness = "Marine"
      lossBasis = GrossLoss
      currency = USD
      cededPercentage = Some 50.0
      contractualCap = None
      attachmentPoint = None
      layerLimit = None
      deductibleRules = "None"
      eligibleLossMethod = "Gross loss"
      approvalState = ApprovalPending
      evidenceRefs = []
      createdAt = now
      previousVersion = None

  approvedCid <- submit tp.cedant do
    exerciseCmd treatyCid ApproveTreaty with
      approver = tp.cedant
      approvalTime = now

  -- Second approval should fail
  submitMustFail tp.cedant do
    exerciseCmd approvedCid ApproveTreaty with
      approver = tp.cedant
      approvalTime = now

  return ()

-- | Test: Treaty participation proposal and acceptance workflow
testTreatyParticipationWorkflow : Script ()
testTreatyParticipationWorkflow = do
  tp <- setupParties
  let now = time (date 2024 Jan 15) 10 0 0

  -- Create and approve treaty
  treatyCid <- submit tp.cedant do
    createCmd TreatyVersion with
      cedant = tp.cedant
      broker = tp.broker
      operations = tp.operations
      audit = tp.audit
      treatyRef = "QS-2024-003"
      version = 1
      treatyType = QuotaShare
      effectivePeriod = DateRange (date 2024 Jan 1) (date 2024 Dec 31)
      coveredBusiness = "Property"
      lossBasis = GrossLoss
      currency = USD
      cededPercentage = Some 70.0
      contractualCap = Some 5000000.0
      attachmentPoint = None
      layerLimit = None
      deductibleRules = "Standard"
      eligibleLossMethod = "Gross loss"
      approvalState = ApprovalPending
      evidenceRefs = []
      createdAt = now
      previousVersion = None

  approvedTreatyCid <- submit tp.cedant do
    exerciseCmd treatyCid ApproveTreaty with
      approver = tp.cedant
      approvalTime = now

  -- Propose participation to reinsurer1
  proposalCid <- submit tp.cedant do
    createCmd TreatyParticipationProposal with
      cedant = tp.cedant
      reinsurer = tp.reinsurer1
      broker = tp.broker
      operations = tp.operations
      audit = tp.audit
      treatyVersionCid = approvedTreatyCid
      treatyRef = "QS-2024-003"
      treatyVersion = 1
      proposedLinePercentage = 40.0
      coveredLayer = "100% of ceded amount"
      currency = USD
      evidenceRefs = []
      proposedAt = now

  -- Reinsurer accepts
  participationCid <- submit tp.reinsurer1 do
    exerciseCmd proposalCid AcceptProposal with
      acceptTime = now
      acceptEvidence = None

  return ()

-- | Test: Reinsurer can reject participation proposal
testReinsurerRejectsProposal : Script ()
testReinsurerRejectsProposal = do
  tp <- setupParties
  let now = time (date 2024 Jan 15) 10 0 0

  treatyCid <- submit tp.cedant do
    createCmd TreatyVersion with
      cedant = tp.cedant
      broker = tp.broker
      operations = tp.operations
      audit = tp.audit
      treatyRef = "QS-2024-004"
      version = 1
      treatyType = QuotaShare
      effectivePeriod = DateRange (date 2024 Jan 1) (date 2024 Dec 31)
      coveredBusiness = "Aviation"
      lossBasis = GrossLoss
      currency = USD
      cededPercentage = Some 60.0
      contractualCap = None
      attachmentPoint = None
      layerLimit = None
      deductibleRules = "None"
      eligibleLossMethod = "Gross loss"
      approvalState = ApprovalPending
      evidenceRefs = []
      createdAt = now
      previousVersion = None

  approvedCid <- submit tp.cedant do
    exerciseCmd treatyCid ApproveTreaty with
      approver = tp.cedant
      approvalTime = now

  proposalCid <- submit tp.cedant do
    createCmd TreatyParticipationProposal with
      cedant = tp.cedant
      reinsurer = tp.reinsurer1
      broker = tp.broker
      operations = tp.operations
      audit = tp.audit
      treatyVersionCid = approvedCid
      treatyRef = "QS-2024-004"
      treatyVersion = 1
      proposedLinePercentage = 50.0
      coveredLayer = "Full layer"
      currency = USD
      evidenceRefs = []
      proposedAt = now

  -- Reinsurer rejects
  submit tp.reinsurer1 do
    exerciseCmd proposalCid RejectProposal with
      rejectionReason = "Terms not acceptable"
      rejectTime = now

  return ()

-- | Test: Broker cannot unilaterally accept on reinsurer's behalf
