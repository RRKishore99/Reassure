-- | Test: Assessment lifecycle — draft → submitted → approved
testAssessmentLifecycle : Script ()
testAssessmentLifecycle = do
  tp <- setupParties
  let now = time (date 2024 Mar 5) 10 0 0

  -- Create assessment
  assessmentCid <- submit tp.adjuster do
    createCmd LossAssessment with
      adjuster = tp.adjuster
      cedant = tp.cedant
      broker = tp.broker
      operations = tp.operations
      audit = tp.audit
      claimRef = "CLM-2024-001"
      assessmentRef = "ASS-2024-001"
      assessmentVersion = 1
      assessedAmount = usd 500000.0
      deductibleAmount = Some (usd 25000.0)
      salvageAmount = None
      subrogationAmount = None
      otherRecoveries = None
      eligibleLoss = usd 475000.0
      methodology = "On-site inspection with independent valuation"
      lossBasisApplied = NetOfDeductible
      evidenceRefs = [testEvidence tp.adjuster now]
      assessmentStatus = AssessmentDraft
      submittedAt = now
      approvedAt = None
      approvedBy = None
      previousVersion = None
      notes = ""

  -- Submit
  submittedCid <- submit tp.adjuster do
    exerciseCmd assessmentCid SubmitAssessment with
      submitTime = now

  -- Approve
  approvedCid <- submit tp.operations do
    exerciseCmd submittedCid ApproveAssessment with
      approver = tp.operations
      approvalTime = now

  return ()

