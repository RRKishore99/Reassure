-- | ReSure Nexus — Comprehensive Daml Script Tests
-- | Tests all permitted and prohibited state transitions, authorization rules,
-- | numerical boundaries, duplicate handling, and privacy constraints.
module Test.ReSureTests where

import Daml.Script
import DA.Date (date, Month(..))
import DA.Time (time)
import ReSure.Types
import ReSure.Treaty.TreatyVersion
import ReSure.Treaty.TreatyParticipation
import ReSure.Claim.ClaimCase
import ReSure.Assessment.LossAssessment
import ReSure.Allocation.AllocationCycle
import ReSure.Allocation.Disputes
import ReSure.Settlement.Settlement
import ReSure.Registry.UniqueRegistry

-- | Helper: Create standard test parties
data TestParties = TestParties with
    cedant : Party
    reinsurer1 : Party
    reinsurer2 : Party
    broker : Party
    adjuster : Party
    operations : Party
    audit : Party

setupParties : Script TestParties
setupParties = do
  cedant <- allocateParty "Cedant"
  reinsurer1 <- allocateParty "Reinsurer1"
  reinsurer2 <- allocateParty "Reinsurer2"
  broker <- allocateParty "Broker"
  adjuster <- allocateParty "Adjuster"
  operations <- allocateParty "Operations"
  audit <- allocateParty "Audit"
  return TestParties{..}

-- | Helper: Create a standard test evidence reference
testEvidence : Party -> Time -> EvidenceRef
testEvidence party t = EvidenceRef with
    documentId = "DOC-001"
    documentType = ClaimNotification
    contentHash = "a948904f2f0f479b8f8564e9d3b2a72e5e3f5e7d8c9a4b3c2d1e0f1a2b3c4d5e"
    version = 1
    uploadedAt = t
    uploadedBy = party

-- | Helper: Create a standard MonetaryAmount
usd : Decimal -> MonetaryAmount
usd amount = MonetaryAmount amount USD

-- =============================================================================
-- TREATY TESTS
-- =============================================================================

-- | Test: Create and approve a quota-share treaty
testCreateQuotaShareTreaty : Script ()
testCreateQuotaShareTreaty = do
  tp <- setupParties
  let now = time (date 2024 Jan 15) 10 0 0

  -- Create treaty version
  treatyCid <- submit tp.cedant do
    createCmd TreatyVersion with
      cedant = tp.cedant
      broker = tp.broker
      operations = tp.operations
      audit = tp.audit
      treatyRef = "QS-2024-001"
      version = 1
      treatyType = QuotaShare
      effectivePeriod = DateRange (date 2024 Jan 1) (date 2024 Dec 31)
      coveredBusiness = "Property lines"
      lossBasis = GrossLoss
      currency = USD
      cededPercentage = Some 70.0
      contractualCap = Some 5000000.0
      attachmentPoint = None
      layerLimit = None
      deductibleRules = "Standard policyholder deductible applies"
      eligibleLossMethod = "Gross loss less applicable deductible"
      approvalState = ApprovalPending
      evidenceRefs = []
      createdAt = now
      previousVersion = None

  -- Approve the treaty
  approvedTreatyCid <- submit tp.cedant do
    exerciseCmd treatyCid ApproveTreaty with
      approver = tp.cedant
      approvalTime = now

  return ()

